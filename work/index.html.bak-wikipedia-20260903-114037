<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover">

  <meta
    name="theme-color"
    content="#0b0c0f">

  <title>
    Song — Jewish Music Timeline
  </title>

  <link
    rel="stylesheet"
    href="/styles.css">

  <link
    rel="stylesheet"
    href="/work/work.css">
</head>


<body>

<header class="site-header">

  <div class="header-inner">

    <a
      class="brand"
      href="/"
      aria-label="Jewish Music Timeline">

      <span
        class="brand-mark"
        aria-hidden="true">

        <svg
          class="brand-logo-svg"
          viewBox="0 0 48 48">

          <g class="brand-logo-bars">

            <rect
              x="7"
              y="27"
              width="4"
              height="9"
              rx="2">
            </rect>

            <rect
              x="14"
              y="21"
              width="4"
              height="15"
              rx="2">
            </rect>

            <rect
              x="21"
              y="15"
              width="4"
              height="21"
              rx="2">
            </rect>

          </g>

          <path
            class="brand-logo-note-fill"
            d="
              M31 13
              V31.5
              C29.6 30.7 27.9 30.6 26.3 31
              C23.6 31.7 22 33.8 22.6 35.8
              C23.2 37.8 25.7 38.8 28.4 38
              C30.8 37.4 32.4 35.6 32.4 33.6
              V20
              L40 18
              V28.7
              C38.6 27.9 36.9 27.8 35.3 28.2
              C32.6 28.9 31 31 31.6 33
              C32.2 35 34.7 36 37.4 35.2
              C39.8 34.6 41.4 32.8 41.4 30.8
              V13
              Z">
          </path>

        </svg>

      </span>

      <span>
        <strong>
          Jewish Music Timeline
        </strong>

        <small>
          Song history
        </small>
      </span>

    </a>

  </div>

</header>


<div class="source-credit">

  <span>
    Data from
  </span>

  <a
    href="https://musicbrainz.org/"
    target="_blank"
    rel="noopener">
    MusicBrainz
  </a>

</div>


<main class="work-main">

  <div class="work-nav">

    <a href="/search/">
      ← Search
    </a>

  </div>


  <section
    id="loadingState"
    class="work-state">

    <div class="work-state-icon">
      ♪
    </div>

    <h1>
      Loading song…
    </h1>

  </section>


  <section
    id="errorState"
    class="work-state"
    hidden>

    <div class="work-state-icon">
      !
    </div>

    <h1>
      Song not found
    </h1>

    <p>
      This Work is not currently available
      in the Jewish Music Timeline.
    </p>

  </section>


  <div
    id="workContent"
    hidden>

    <section class="work-hero">

      <div class="work-kicker">
        Song / Work
      </div>

      <h1
        id="workTitle"
        dir="auto">
      </h1>

      <div
        id="workCredits"
        class="work-credits"
        hidden>
      </div>

      <div
        id="workStats"
        class="work-stats">
      </div>

      <div class="work-actions">

        <a
          id="musicbrainzLink"
          class="work-mb-link"
          target="_blank"
          rel="noopener">
          View Work on MusicBrainz ↗
        </a>

      </div>

    </section>


    <section class="versions-section">

      <div class="versions-heading">

        <div>

          <h2>
            Recorded Versions
          </h2>

          <p>
            Recordings by artists in the
            Jewish Music Timeline collection.
          </p>

        </div>

        <span
          id="versionCount"
          class="version-count">
        </span>

      </div>


      <div
        id="versionGrid"
        class="version-grid">
      </div>

    </section>

  </div>

</main>


<footer>

  <p>
    Song and recording relationships from

    <a
      href="https://musicbrainz.org/"
      target="_blank"
      rel="noopener">
      MusicBrainz
    </a>
  </p>

</footer>


<script src="/cover-fallback.js"></script>
<script src="/work/work.js"></script>

  <script src="/work/service-links.js?v=1"></script>

</body>
</html>
